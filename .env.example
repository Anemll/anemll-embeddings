# After: python scripts/download_models.py
# These are the defaults; with the default layout you can leave them unset.
# (override dest with --dest or ANEMLL_EMBEDDINGS_HOME)
# ANEMLL_EMBEDDINGS_HOME=$HOME/.anemll-embeddings
ANEMLL_EMBEDDINGS_MODEL=$HOME/.anemll-embeddings/embeddinggemma-2
ANEMLL_EMBEDDINGS_ARTIFACTS=$HOME/.anemll-embeddings/artifacts
# Python that can `import coreai.runtime` (README -> "Core AI runtime"):
#   python3.13 -m venv ~/.anemll-embeddings/coreai-venv
#   ~/.anemll-embeddings/coreai-venv/bin/python -m pip install "coreai-core==1.0.0b2" numpy
ANEMLL_COREAI_PYTHON=$HOME/.anemll-embeddings/coreai-venv/bin/python

# Optional: redirect the Core AI specialization cache
# (cache = $CFFIXED_USER_HOME/Library/Caches/coreai-cache)
# CFFIXED_USER_HOME=/path/to/writable/home

# Demo (no authentication; keep 127.0.0.1 unless on a trusted LAN)
# ANEMLL_DEMO_HOST=127.0.0.1
# ANEMLL_DEMO_PORT=8766
# ANEMLL_DEMO_MAX_UPLOAD_MB=40
# ANEMLL_DEMO_MAX_JSON_KB=256

# Optional Hugging Face caches
# HF_HOME=$HOME/.cache/huggingface
# HUGGINGFACE_HUB_CACHE=$HOME/.cache/huggingface
